{
  "name": "wk-content-type-ld-json",
  "category": "domain-binding",
  "description": "`application/ld+json` is not application/json.",
  "cbor_file": "wk-content-type-ld-json.cbor",
  "cbor_sha256": "df3f34769fd89a9e34ab643b54d9df67514d1cd375e217e00caf0e9fe8407ec9",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/ld+json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
