{
  "name": "wk-domain-member-differs-in-case",
  "category": "domain-binding",
  "description": "`domain` is `Example.com`: the name must be equal as written (canonical names are lowercase).",
  "cbor_file": "wk-domain-member-differs-in-case.cbor",
  "cbor_sha256": "cd8a3aae4b1558679fc2dc60fc33725bd77bf43e61b5c6beac9611b0656f97e1",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"domain\":\"Example.com\",\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
