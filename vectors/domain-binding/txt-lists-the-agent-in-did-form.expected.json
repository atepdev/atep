{
  "name": "txt-lists-the-agent-in-did-form",
  "category": "domain-binding",
  "description": "`id=did:atep:...` is an alias of the `atep:` form.",
  "cbor_file": "txt-lists-the-agent-in-did-form.cbor",
  "cbor_sha256": "39b55423bbd54e6496b2969803d566072bf2bf96d37070fb74ecbb70d324baa9",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {},
      "txt": {
        "_atep.example.com": {
          "records": [
            "v=atep1 id=did:atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a"
          ],
          "dnssec_validated": true
        }
      }
    }
  },
  "expected": {
    "well_known": "absent",
    "dns": "listed",
    "outcome": "bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
