{
  "name": "subdomain-gets-no-record-from-its-parent",
  "category": "domain-binding",
  "description": "The domain asked about is `a.example.com`; only `example.com` publishes records, and they list the Agent ID. A record at example.com says nothing about a.example.com and the checker does not search up the tree: it reads exactly the well-known document of a.example.com and `_atep.a.example.com`, finds nothing, and does not bind.",
  "cbor_file": "subdomain-gets-no-record-from-its-parent.cbor",
  "cbor_sha256": "ad060f85e0f1179e850176eb3d23280191110f52da48f4edaacf16ad706bdba2",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "a.example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {
        "_atep.example.com": {
          "records": [
            "v=atep1 id=atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a"
          ],
          "dnssec_validated": true
        }
      }
    }
  },
  "expected": {
    "well_known": "absent",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "a.example.com"
      ],
      "txt": [
        "_atep.a.example.com"
      ]
    }
  }
}
