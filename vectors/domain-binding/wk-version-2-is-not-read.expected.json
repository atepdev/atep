{
  "name": "wk-version-2-is-not-read",
  "category": "domain-binding",
  "description": "`version` is 2: a document of another version is not read.",
  "cbor_file": "wk-version-2-is-not-read.cbor",
  "cbor_sha256": "ee0dc51b81a21dfb20e3c2dea890b29cb968476dbddd2f08faa4eb83530b5737",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":2,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
