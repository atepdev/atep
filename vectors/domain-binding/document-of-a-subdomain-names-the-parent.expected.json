{
  "name": "document-of-a-subdomain-names-the-parent",
  "category": "domain-binding",
  "description": "The document fetched for `a.example.com` has `domain` `example.com`: it does not equal the name it was fetched for, so it is invalid.",
  "cbor_file": "document-of-a-subdomain-names-the-parent.cbor",
  "cbor_sha256": "d44f38bd7486beeb1045beba3d3213f231c9380ce3e632dd25884747a0e41d44",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "a.example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "a.example.com": {
          "status": 200,
          "final_url": "https://a.example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"domain\":\"example.com\",\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "a.example.com"
      ],
      "txt": [
        "_atep.a.example.com"
      ]
    }
  }
}
