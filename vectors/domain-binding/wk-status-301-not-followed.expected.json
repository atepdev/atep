{
  "name": "wk-status-301-not-followed",
  "category": "domain-binding",
  "description": "HTTP 301 reaching the checker (the fetcher follows the redirects it may follow): any other status makes the document invalid.",
  "cbor_file": "wk-status-301-not-followed.cbor",
  "cbor_sha256": "8ad9e84865b7846432d778e99ee8b7aee2febbf945752b4c47cb4360a7e12b13",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 301,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
