{
  "name": "wk-domain-member-names-a-subdomain",
  "category": "domain-binding",
  "description": "`domain` is `www.example.com` in the document fetched for `example.com`: the member must equal the name it was fetched for, so the document is invalid.",
  "cbor_file": "wk-domain-member-names-a-subdomain.cbor",
  "cbor_sha256": "ea01d4bf9aa53f4296efd4aed5c50bf6bf8ad72cf2dec847fbde3ecd2905e915",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"domain\":\"www.example.com\",\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
