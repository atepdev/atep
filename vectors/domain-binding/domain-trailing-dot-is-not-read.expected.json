{
  "name": "domain-trailing-dot-is-not-read",
  "category": "domain-binding",
  "description": "The domain has a trailing dot: not canonical, nothing is read.",
  "cbor_file": "domain-trailing-dot-is-not-read.cbor",
  "cbor_sha256": "6efba3415aad79102bafcfedc427d9a5609f94de9489875ba70717fdb4168c9d",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com.",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {
        "_atep.example.com": {
          "records": [
            "v=atep1 id=atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a"
          ],
          "dnssec_validated": true
        }
      }
    }
  },
  "expected": {
    "well_known": "not-read",
    "dns": "not-read",
    "outcome": "not-bound",
    "queried": {
      "well_known": [],
      "txt": []
    }
  }
