{
  "name": "document-lists-txt-names-another-agent",
  "category": "domain-binding",
  "description": "The document lists the Agent ID and the TXT record names only another one: contradiction, not bound.",
  "cbor_file": "document-lists-txt-names-another-agent.cbor",
  "cbor_sha256": "977a6632506cf073259f3b0e89889485b448a0376783854cc0324bf087c640d1",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {
        "_atep.example.com": {
          "records": [
            "v=atep1 id=atep:dvfnmd6cvmhp6ywwhsgmgypyqi2kqbvnma77n36ybswo32qmyrra"
          ],
          "dnssec_validated": true
        }
      }
    }
  },
  "expected": {
    "well_known": "listed",
    "dns": "not-listed",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
