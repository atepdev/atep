{
  "name": "require-both-only-the-document-lists",
  "category": "domain-binding",
  "description": "`require_both`; the document lists the Agent ID and the TXT name has no data: not bound (the one listing that is enough without the option is not enough with it).",
  "cbor_file": "require-both-only-the-document-lists.cbor",
  "cbor_sha256": "a7e8eec46417633492d5b2a3d827bbd7152e1b46fb3013cfce29c635ee3c95c1",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": true,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "listed",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
