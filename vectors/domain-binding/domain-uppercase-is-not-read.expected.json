{
  "name": "domain-uppercase-is-not-read",
  "category": "domain-binding",
  "description": "The domain is `Example.com`: not a canonical lowercase DNS name, so nothing is read (the sources are `not-read`, no name is queried) and the result is not bound even though records for the lowercase name list the Agent ID.",
  "cbor_file": "domain-uppercase-is-not-read.cbor",
  "cbor_sha256": "b37fb0c369ecc8b727c4b1dc9f6995c793f8e3fc2329bc3262b167e4152c48d9",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "Example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {
        "_atep.example.com": {
          "records": [
            "v=atep1 id=atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a"
          ],
          "dnssec_validated": true
        }
      }
    }
  },
  "expected": {
    "well_known": "not-read",
    "dns": "not-read",
    "outcome": "not-bound",
    "queried": {
      "well_known": [],
      "txt": []
    }
  }
}
