{
  "name": "wk-redirect-to-another-host",
  "category": "domain-binding",
  "description": "The document came from another host.",
  "cbor_file": "wk-redirect-to-another-host.cbor",
  "cbor_sha256": "80c2c1da58041d56b320bbe677629c00d59405e0fbaf9dd7abb7bd011bb7ee76",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://evil.example.net/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "invalid",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
