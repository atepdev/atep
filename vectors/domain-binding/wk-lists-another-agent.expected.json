{
  "name": "wk-lists-another-agent",
  "category": "domain-binding",
  "description": "The document is valid and lists another Agent ID only: not listed, not bound.",
  "cbor_file": "wk-lists-another-agent.cbor",
  "cbor_sha256": "4f9a669ebf58bfec9522e0669c6f9086e4a6022f6354290ce3b0e0a41c03655f",
  "inputs": {
    "check": "domain-binding",
    "fixture": {
      "domain": "example.com",
      "agent_id": "atep:hae4ne6cndu4bhq32zje4gp2ogcsruvk2c722fiws2ztp6iazq6a",
      "options": {
        "require_both": false,
        "require_dnssec": false
      },
      "well_known": {
        "example.com": {
          "status": 200,
          "final_url": "https://example.com/.well-known/atep.json",
          "content_type": "application/json",
          "body": "{\"version\":1,\"agents\":[\"atep:dvfnmd6cvmhp6ywwhsgmgypyqi2kqbvnma77n36ybswo32qmyrra\"]}"
        }
      },
      "txt": {}
    }
  },
  "expected": {
    "well_known": "not-listed",
    "dns": "absent",
    "outcome": "not-bound",
    "queried": {
      "well_known": [
        "example.com"
      ],
      "txt": [
        "_atep.example.com"
      ]
    }
  }
}
